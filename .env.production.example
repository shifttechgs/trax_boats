# ---------------------------------------------------------------------------
# Production template for podhosting. Copy to .env ON THE SERVER and fill in.
# Never commit the filled-in copy — .gitignore excludes .env / .env.production.
# Generate a FRESH key on the server: php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME="Trax Boats and Trailers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://traxboatsandtrailers.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# This is a brochure site: no auth, no models, no queued jobs. File drivers
# remove the database dependency entirely, so there is no sqlite file to
# create, place outside public_html, or keep writable. If you would rather
# use the MySQL database podhosting gives you, switch these back to
# "database", set the DB_* values below, and run: php artisan migrate
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Only needed if you switch SESSION_DRIVER/CACHE_STORE back to "database"
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Port 465 = implicit SSL. Laravel resolves this to the "smtps" scheme
# automatically, so MAIL_SCHEME can stay unset. Use 587 with
# MAIL_SCHEME=smtp if podhosting requires STARTTLS instead.
MAIL_MAILER=smtp
MAIL_HOST=mail.shifttechgs.com
MAIL_PORT=465
MAIL_USERNAME=sales@shifttechgs.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="customer@shifttechgs.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact form submissions are delivered. Read via config('mail.contact_to').
CONTACT_EMAIL=info@shifttechgs.com
